# Cloudflare API credentials for CI deployment tests
# Copy this file to .env and fill in your values

# Cloudflare API token with the following permissions:
# - Workers Scripts: Edit
# - Workers KV Storage: Edit
# - Workers R2 Storage: Edit
# - D1: Edit
CLOUDFLARE_API_TOKEN=your_api_token_here

# Your Cloudflare account ID
# Found in the Cloudflare dashboard URL: https://dash.cloudflare.com/{account_id}
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# CI run ID (used for naming resources uniquely)
# For local testing, use any unique value. Examples:
#   CI_RUN_ID=local-1234567890
#   CI_RUN_ID=dev-myname-001
# Generate a timestamp in your shell with: date +%s
CI_RUN_ID=local-1234567890
