{
	"name": "better-wrangler",
	"version": "0.1.0",
	"description": "drop in replacement for wrangler",
	"author": "natewong1313",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/natewong1313/better-wrangler.git"
	},
	"bugs": {
		"url": "https://github.com/natewong1313/better-wrangler/issues"
	},
	"homepage": "https://github.com/natewong1313/better-wrangler#readme",
	"keywords": ["wrangler", "cloudflare", "workers", "testing"],
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"bin": {
		"bw": "./dist/cli.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./preload": {
			"types": "./dist/preload.d.mts",
			"import": "./dist/preload.mjs"
		}
	},
	"files": ["dist"],
	"workspaces": ["examples/*"],
	"scripts": {
		"build": "tsdown",
		"prepublishOnly": "bun run build",
		"dev": "bun run src/cli.ts dev",
		"sync": "bun run src/cli.ts sync",
		"check-types": "tsc",
		"lint": "oxlint src/",
		"lint:fix": "oxlint src/ --fix",
		"format": "oxfmt src/ --write",
		"format:check": "oxfmt src/",
		"test": "vitest",
		"test:unit": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration",
		"test:e2e": "vitest run tests/e2e",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260129.0",
		"@tailwindcss/vite": "^4.1.18",
		"@types/bun": "^1.3.7",
		"@types/node": "^25.1.0",
		"@types/react": "^19.2.10",
		"@types/react-dom": "^19.2.3",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^5.1.2",
		"@vitest/coverage-v8": "^4.0.18",
		"lefthook": "^2.0.16",
		"oxfmt": "^0.27.0",
		"oxlint": "^1.42.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"tailwindcss": "^4.1.18",
		"tsdown": "^0.20.1",
		"typescript": "^5.5.2",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"ws": "^8.19.0"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/source-sans-3": "^5.2.9",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-slot": "^1.2.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"esbuild": "^0.27.2",
		"lucide-react": "^0.563.0",
		"miniflare": "^4.20260124.0",
		"tailwind-merge": "^3.4.0",
		"tw-animate-css": "^1.4.0",
		"wrangler": "^4.61.0"
	}
}
