{
	"name": "better-wrangler",
	"version": "0.1.0",
	"description": "drop in replacement for wrangler",
	"author": "natewong1313",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/natewong1313/better-wrangler.git"
	},
	"bugs": {
		"url": "https://github.com/natewong1313/better-wrangler/issues"
	},
	"homepage": "https://github.com/natewong1313/better-wrangler#readme",
	"keywords": ["wrangler", "cloudflare", "workers", "testing"],
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"bin": {
		"bw": "./dist/cli.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./preload": {
			"types": "./dist/preload.d.mts",
			"import": "./dist/preload.mjs"
		}
	},
	"files": ["dist"],
	"workspaces": ["examples/*"],
	"scripts": {
		"build": "tsdown",
		"prepublishOnly": "bun run build",
		"dev": "bun run src/cli.ts dev",
		"sync": "bun run src/cli.ts sync",
		"check-types": "tsc",
		"lint": "oxlint src/",
		"lint:fix": "oxlint src/ --fix",
		"format": "oxfmt src/ --write",
		"format:check": "oxfmt src/",
		"test": "vitest",
		"test:unit": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration",
		"test:e2e": "vitest run tests/e2e",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260129.0",
		"@types/bun": "^1.3.7",
		"@types/node": "^25.1.0",
		"@vitest/coverage-v8": "^4.0.18",
		"lefthook": "^2.0.16",
		"oxfmt": "^0.27.0",
		"oxlint": "^1.42.0",
		"tsdown": "^0.20.1",
		"typescript": "^5.5.2",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"esbuild": "^0.27.2",
		"miniflare": "^4.20260124.0",
		"wrangler": "^4.61.0"
	}
}
